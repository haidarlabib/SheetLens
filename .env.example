# SheetLens Environment Configuration Example
# Copy this file to .env.local and populate with your actual credentials.

# Google OAuth 2.0 Credentials (From Google Cloud Console: APIs & Services > Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Picker API (Optional: Google Cloud Project Number & Browser-restricted API Key for Picker dialog)
NEXT_PUBLIC_GOOGLE_APP_ID=""
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=""

# Session Encryption Key (Optional: 32+ characters random string for AES-256-GCM session tokens)
# If omitted, a deterministic key derived from GOOGLE_CLIENT_SECRET is used.
SESSION_SECRET=""

# Application Base URL (Optional, defaults to http://localhost:3000 or Vercel URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini API (Server-Side Vision Extraction)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
